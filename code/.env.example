# Copy to .env and edit. Relative paths are resolved from code/.
# StreetMenu-VN labels and redacted images (data/ of this repository)
SMV_DATA_DIR=../data
# Optional: image root if it is not $SMV_DATA_DIR/images
SMV_IMAGES_DIR=
SMV_MODELS_DIR=checkpoints
SMV_OUT_DIR=outputs
SMV_CACHE_DIR=cache
# GPU index and CPU cores to use
SMV_GPU_ID=0
SMV_CPU_AFFINITY=0-9
SMV_NUM_THREADS=10
# Python interpreters of the side environments (created by `make setup`)
SMV_VLLM_PYTHON=.venvs/smv_vllm/bin/python
SMV_OCR_PYTHON=.venvs/smv_ocr/bin/python
# Hugging Face (HF_TOKEN is needed only for gated models)
HF_HOME=.cache/hf
HF_TOKEN=
SMV_CACHE_ROOT=.cache
